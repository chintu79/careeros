# CareerOS — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env containing real credentials or API keys.

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/interniq

# AI Provider: Groq API (Complex Reasoning: Resumes, Tailoring, JDs, Technical Analysis)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# AI Provider: Local Ollama (Everyday Interactions: Chat, Text Classification, Summarization)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=bge-m3

# Authentication & Security
# Token lifetime for freshly minted bearer tokens (seconds). Max 86400 (24h).
CAREEROS_TOKEN_TTL=86400
# Token version. Bump ("1" -> "2") to revoke ALL outstanding tokens.
TOKEN_VERSION=1
# Comma-separated list of allowed origins for browser CORS requests.
# No wildcards. Same-origin deploys (nginx proxy) do not need CORS at all.
CAREEROS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Set to the number of reverse-proxy hops in front of uvicorn when serving X-Forwarded-For.
# 0 means X-Forwarded-For is ignored entirely (safest default).
TRUST_PROXY_HOPS=0

# Upload limits
MAX_UPLOAD_BYTES=10485760

# Token Vault Key (Fernet symmetric encryption for stored tokens - auto-generated if empty)
# TOKEN_VAULT_KEY=

# Job Board Connectors (Optional)
ADZUNA_APP_ID=c457c0fa
ADZUNA_APP_KEY=3fce884460e60e5fae355dcfb9a9e70f
