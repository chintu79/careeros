# CareerOS production example template — all values are placeholders.
# Never commit real credentials.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=bge-m3

AUTH_REQUIRED=true
ENVIRONMENT=production
CAREEROS_RUN_MIGRATIONS=0
CAREEROS_TOKEN_TTL=86400
CAREEROS_TOKEN_SECRET=
CAREEROS_ALLOWED_ORIGINS=http://localhost:8080
TRUST_PROXY_HOPS=1
INTERNAL_GATEWAY_SECRET=
CAREEROS_MIGRATION_AUTHORIZATION=
CAREEROS_DIAGNOSTICS_TOKEN=
MAX_UPLOAD_BYTES=10485760
SEED_DEMO_DATA=false
SECRET_KEY=
