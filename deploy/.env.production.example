CAREEROS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CAREEROS_TOKEN_TTL=86400
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54322/interniq
# envsitter: REQUIRED for AI features; readiness reports missing key
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
MAX_UPLOAD_BYTES=10485760
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=bge-m3
TOKEN_VERSION=1
TRUST_PROXY_HOPS=0
SECRET_KEY=
CAREEROS_TOKEN_SECRET=
INTERNAL_GATEWAY_SECRET=
ENVIRONMENT=production
AUTH_REQUIRED=true
SEED_DEMO_DATA=false
RUN_MIGRATIONS=0
CAREEROS_RUN_MIGRATIONS=0
# envsitter: Only for authorized production migrations: must equal the --target fingerprint printed by `backend.ops.migrate --dry-run`. Leave empty otherwise; production migrations are refused without it.
CAREEROS_MIGRATION_AUTHORIZATION=
# envsitter: Optional. Bearer token for /api/internal/metrics and /api/internal/diagnostics. Leave empty to disable both endpoints (they return 404). Set only for operators that need to scrape diagnostics.
CAREEROS_DIAGNOSTICS_TOKEN=
