# syntax=docker/dockerfile:1.6

FROM python:3.14-slim AS builder
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.14-slim
LABEL org.opencontainers.image.source="interniq/careeros" org.opencontainers.image.version="3.0.7"

# Create non-root user
RUN groupadd -r careeros && useradd -r -g careeros -m -d /home/careeros careeros
USER careeros
WORKDIR /app

# Dependencies copied from builder
COPY --from=builder --chown=careeros:careeros /install /usr/local

# Application (resume artifacts are NOT baked into the image: volume-mounted, contains PII)
COPY --chown=careeros:careeros backend/app ./backend/app
COPY --chown=careeros:careeros backend/ops ./backend/ops

# Mount point for the persistent resume volume; empty until operator seeds it.
RUN mkdir -p /app/backend/storage/resumes

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8005

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8005/api/health', timeout=5)" || exit 1

CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8005", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
